[Unit]
Description=Tala Eats Restaurantes — isolated Nginx web application
After=network.target
[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=talaeats-restaurantes-pwa
RuntimeDirectoryMode=0755
ExecStart=/usr/sbin/nginx -c /etc/talaeats-restaurantes-pwa/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -c /etc/talaeats-restaurantes-pwa/nginx.conf -s reload
Restart=on-failure
RestartSec=4s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/talaeats-restaurantes-pwa
CapabilityBoundingSet=
AmbientCapabilities=
[Install]
WantedBy=multi-user.target
