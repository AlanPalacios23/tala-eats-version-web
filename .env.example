# Public UI switches only. NEVER put Stripe secret keys or database URLs here.
VITE_DRIVER_ACTIONS_ENABLED=false

# Required for Tala Eats Crece QR: customer PWA public HTTPS origin, no path.
# Set only after confirming /comercio/:id opens the intended customer storefront.
# VITE_TALA_CUSTOMERS_BASE_URL=https://your-customers-domain.example

# Optional opt-in sales CTA for Tala Eats Crece.
# International WhatsApp business number digits ONLY, no +, spaces, URL or query.
# Example format: country prefix followed by subscriber phone. Do NOT use an admin login contact.
# When unset, no WhatsApp CTA is rendered.
# VITE_TALA_CRECE_WHATSAPP=
